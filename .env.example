# Copy this file to .env for local development.
# Never commit real API keys or service credentials.

# Optional routing providers. Leave blank to use OSRM and local straight-line fallback.
OPENROUTESERVICE_API_KEY=
GRAPHHOPPER_API_KEY=
MAPBOX_ACCESS_TOKEN=

# Optional local Function proxy override. Leave blank for deployed Firebase Functions.
FIREBASE_FUNCTIONS_REGION=us-central1
MAP_PROXY_BASE_URL=
