rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function role() {
      return userDoc().data.role;
    }

    function isAdmin() {
      return isSignedIn() && role() == 'admin';
    }

    function isCustomer() {
      return isSignedIn() && role() == 'customer';
    }

    function isProvider() {
      return isSignedIn() && role() == 'provider';
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function requestDoc(id) {
      return get(/databases/$(database)/documents/requests/$(id));
    }

    function onlyChanged(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    function canReadRequest(data) {
      return isAdmin() ||
        (isSignedIn() && data.customerUid == request.auth.uid) ||
        (isProvider() && (
          data.providerUid == request.auth.uid ||
          data.offeredProviderUid == request.auth.uid
        ));
    }

    function currentProviderIsAvailable() {
      let providerDoc = get(/databases/$(database)/documents/providers/$(request.auth.uid));

      return providerDoc.data.isApproved == true &&
        (providerDoc.data.isOnline == true || providerDoc.data.online == true) &&
        providerDoc.data.isBusy != true;
    }

    function offeredProviderIsAvailable() {
      let providerId = request.resource.data.offeredProviderUid;
      let providerDoc = get(/databases/$(database)/documents/providers/$(providerId));

      return providerId is string &&
        exists(/databases/$(database)/documents/providers/$(providerId)) &&
        providerDoc.data.isApproved == true &&
        (providerDoc.data.isOnline == true || providerDoc.data.online == true) &&
        providerDoc.data.isBusy != true &&
        providerDoc.data.hasActiveMission != true &&
        providerDoc.data.activeMission != true &&
        providerDoc.data.onActiveMission != true;
    }

    function customerCanCancelOwnRequest() {
      return isCustomer() &&
        resource.data.customerUid == request.auth.uid &&
        resource.data.status == 'searching' &&
        request.resource.data.status == 'cancelled';
    }

    function customerCanDispatchOwnRequest() {
      return isCustomer() &&
        resource.data.customerUid == request.auth.uid &&
        request.resource.data.customerUid == request.auth.uid &&
        resource.data.status == 'searching' &&
        request.resource.data.status == 'searching' &&
        resource.data.providerUid == null &&
        request.resource.data.providerUid == null &&
        resource.data.offeredProviderUid == null &&
        offeredProviderIsAvailable() &&
        onlyChanged([
          'offeredProviderUid',
          'offeredAt',
          'offerExpiresAt',
          'rejectedProviderUids',
          'updatedAt',
          'updatedAtIso'
        ]);
    }

    function customerCanRetrySearchingRequest() {
      return isCustomer() &&
        resource.data.customerUid == request.auth.uid &&
        request.resource.data.customerUid == request.auth.uid &&
        resource.data.status == 'searching' &&
        request.resource.data.status == 'searching' &&
        request.resource.data.providerUid == null &&
        request.resource.data.offeredProviderUid == null &&
        request.resource.data.offeredAt == null &&
        request.resource.data.offerExpiresAt == null &&
        onlyChanged([
          'offeredProviderUid',
          'offeredAt',
          'offerExpiresAt',
          'rejectedProviderUids',
          'updatedAt',
          'updatedAtIso'
        ]);
    }

    function customerCanRateProvider() {
      return isCustomer() &&
        resource.data.customerUid == request.auth.uid &&
        resource.data.status == 'completed' &&
        request.resource.data.status == 'completed' &&
        onlyChanged([
          'clientRatingForProvider',
          'clientReviewForProvider',
          'isClientRated',
          'clientRatedAtIso',
          'updatedAt',
          'updatedAtIso'
        ]);
    }

    function providerCanRateClient() {
      return isProvider() &&
        resource.data.providerUid == request.auth.uid &&
        resource.data.status == 'completed' &&
        request.resource.data.status == 'completed' &&
        onlyChanged([
          'providerRatingForClient',
          'providerReviewForClient',
          'isProviderRated',
          'providerRatedAtIso',
          'updatedAt',
          'updatedAtIso'
        ]);
    }

    function providerCanUpdateOfferedOrAssignedRequest() {
      return isProvider() && (
        (
          resource.data.status == 'searching' &&
          resource.data.offeredProviderUid == request.auth.uid &&
          request.resource.data.status == 'accepted' &&
          currentProviderIsAvailable()
        ) ||
        (
          resource.data.providerUid == request.auth.uid &&
          resource.data.status != 'completed' &&
          resource.data.status != 'cancelled'
        )
      );
    }

    function providerCanRejectOfferedRequest() {
      return isProvider() &&
        resource.data.status == 'searching' &&
        request.resource.data.status == 'searching' &&
        resource.data.offeredProviderUid == request.auth.uid &&
        request.resource.data.offeredProviderUid == null &&
        request.resource.data.offeredAt == null &&
        request.resource.data.offerExpiresAt == null &&
        request.resource.data.providerUid == null &&
        request.resource.data.rejectedProviderUids.hasAll([request.auth.uid]) &&
        onlyChanged([
          'offeredProviderUid',
          'offeredAt',
          'offerExpiresAt',
          'rejectedProviderUids',
          'updatedAt',
          'updatedAtIso'
        ]);
    }

    function customerCanUpdateProviderRatingOnly() {
      return isCustomer() &&
        onlyChanged([
          'rating',
          'ratingCount',
          'updatedAtIso'
        ]);
    }

    match /phone_lookup/{phone} {
      allow read: if true;
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    match /users/{userId} {
      allow read: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow create: if isOwner(userId) || isAdmin();
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    match /providers/{providerId} {
      allow read: if isSignedIn();
      allow create: if isOwner(providerId) || isAdmin();

      allow update: if isAdmin() ||
        isOwner(providerId) ||
        customerCanUpdateProviderRatingOnly();

      allow delete: if isAdmin();
    }

    match /requests/{requestId} {
      allow read: if isSignedIn() && canReadRequest(resource.data);

      allow create: if isCustomer() &&
        request.resource.data.customerUid == request.auth.uid &&
        request.resource.data.status == 'searching';

      allow update: if isAdmin() ||
        customerCanCancelOwnRequest() ||
        customerCanDispatchOwnRequest() ||
        customerCanRetrySearchingRequest() ||
        customerCanRateProvider() ||
        providerCanRejectOfferedRequest() ||
        providerCanUpdateOfferedOrAssignedRequest() ||
        providerCanRateClient();

      allow delete: if isAdmin();
    }

    match /tracking/{requestId} {
      allow read: if isSignedIn() && canReadRequest(requestDoc(requestId).data);

      allow create, update: if isProvider() &&
        requestDoc(requestId).data.providerUid == request.auth.uid;

      allow delete: if isProvider() &&
        requestDoc(requestId).data.providerUid == request.auth.uid;
    }

    match /app_config/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /app_settings/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /app_notifications/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /admin_activity_logs/{docId} {
      allow read, write: if isAdmin();
    }

    match /adminLogs/{docId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    match /admin_audit_logs/{docId} {
      allow read, write: if isAdmin();
    }

    match /admin_audit/{docId} {
      allow read, write: if isAdmin();
    }

    match /audit_logs/{docId} {
      allow read, write: if isAdmin();
    }

    match /request_chats/{requestId} {
      allow read, write: if isSignedIn() &&
        canReadRequest(requestDoc(requestId).data);

      match /messages/{messageId} {
        allow read, write: if isSignedIn() &&
          canReadRequest(requestDoc(requestId).data);
      }
    }

    match /chats/{chatId} {
      allow read, write: if isSignedIn();
    }
  }
}
