# Uncomment this line to define a global platform for your project
platform :ios, '15.0'

# CocoaPods analytics sends network stats synchronously, but Flutter
# builds asynchronously, so disable it to avoid blocking builds.
install! 'cocoapods', disable_stats: true

# Set this to true to enable Swift Package Manager
# It will speed up your build but is still experimental

target 'Runner' do
  use_frameworks!
  use_modular_headers!

  # Firebase Core
  pod 'Firebase/Core'
  pod 'Firebase/Auth'
  pod 'Firebase/Firestore'
  pod 'Firebase/Storage'
  pod 'Firebase/Messaging'
  
  # Google Maps (if using)
  # pod 'GoogleMaps'
  
  # Firebase Analytics (optional)
  # pod 'Firebase/Analytics'
end

# Flutter Podfile configuration
flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))

# Post-install hooks
post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    
    target.build_configurations.each do |config|
      # Minimum iOS deployment version
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '12.0'
      
      # Bitcode settings
      config.build_settings['ENABLE_BITCODE'] = 'NO'
      
      # Always embed Swift standard libraries
      config.build_settings['ALWAYS_EMBED_SWIFT_STANDARD_LIBRARIES'] = 'YES'
      
      # Remove architectures not needed for simulator
      # config.build_settings['EXCLUDED_ARCHS[sdk=iphonesimulator*]'] = 'armv7 arm64'
      
      # Deployment target
      config.build_settings['TARGETED_DEVICE_FAMILY'] = '1,2' # iPhone and iPad
      
      # Build settings for release
      if config.build_settings['CONFIGURATION'] == 'Release'
        config.build_settings['SWIFT_OPTIMIZATION_LEVEL'] = '-Owholemodule'
      end
    end
  end
  
  # Fix for Firebase and other pods
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] ||= [
        '$(inherited)',
        'PERMISSION_LOCATION=1',
        'PERMISSION_NOTIFICATIONS=1',
      ]
    end
  end
end
